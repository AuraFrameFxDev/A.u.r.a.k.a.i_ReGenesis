[Unit]
Description=ReGenesis LDO Core - Genesis Backend WebSocket Server
Documentation=man:systemd.unit(5)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi

# Set working directory to the backend folder
WorkingDirectory=/home/pi/A.u.r.a.k.a.i_ReGenesis/app/ai_backend

# Activate venv and start the web server
ExecStart=/bin/bash -c 'source /home/pi/A.u.r.a.k.a.i_ReGenesis/app/ai_backend/venv/bin/activate && python3 /home/pi/A.u.r.a.k.a.i_ReGenesis/app/ai_backend/genesis_web_server.py'

# Restart policy
Restart=on-failure
RestartSec=10
StartLimitInterval=60
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=genesis-backend

# Security
NoNewPrivileges=true
PrivateTmp=true

# Environment
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONDONTWRITEBYTECODE=1"

# Timeout
TimeoutStartSec=30
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target

